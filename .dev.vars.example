NOTIFY_FROM="notifications@notify.bldnex.com"
NOTIFY_TO="BLDNEX.DEV@GMAIL.COM"
ACCESS_TEAM_DOMAIN=""
ACCESS_AUD=""
ADMIN_EMAILS="BLDNEX.DEV@GMAIL.COM"
