---
import { site, contactHref } from '../data/site';
interface Props { title?: string; description?: string; label?: string; }
const {
  title = '다음 제품의 시작을 함께 정리해보세요.',
  description = '만들고 싶은 것과 지금 고민하는 점을 알려주세요. 구체적인 기능 목록이 없어도 괜찮습니다.',
  label = '프로젝트 문의',
} = Astro.props;
---
<section class="final-cta section-wrap">
  <p class="eyebrow">LET’S BUILD WHAT’S NEXT.</p>
  <h2 class="ko-heading">{title}</h2>
  <p class="body-copy">{description}</p>
  <div class="actions">
    <a class="button button-primary" href="/contact">{label} <span aria-hidden="true">↗</span></a>
    <a class="text-link email-link" href={contactHref}>{site.email}</a>
  </div>
</section>
