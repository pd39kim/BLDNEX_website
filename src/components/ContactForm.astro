---
import { projectTypes, budgets, schedules, POLICY_VERSION } from '../../shared/contact';
import '../styles/contact.css';
const choiceFields = [
  { name: 'budget', label: '예산 범위', choices: budgets },
  { name: 'schedule', label: '희망 일정', choices: schedules },
];
---
<div class="inquiry-card" id="inquiry">
  <p class="eyebrow">PROJECT INQUIRY</p>
  <h2 class="ko-heading" id="contact-heading">프로젝트에 대해<br />알려주세요.</h2>
  <p class="body-copy">만들고 싶은 것과 현재 상황을 적어 주세요.<br />구체적인 기획서가 없어도 괜찮습니다.</p>
  <p class="intake-notice" id="intake-notice" role="status">온라인 접수 가능 여부를 확인하고 있습니다. 이메일로도 문의하실 수 있습니다.</p>
  <button type="button" class="text-link config-retry" hidden>연결 다시 확인</button>
  <noscript><p class="intake-notice">온라인 접수에는 JavaScript가 필요합니다. 아래 이메일로 문의해 주세요.</p></noscript>
  <form id="project-inquiry" action="/api/contact" method="post" novalidate aria-describedby="intake-notice">
    <fieldset class="inquiry-fields">
      <legend class="sr-only">프로젝트 문의 내용</legend>
      <div class="form-section-label"><span>01 / PROJECT</span><span>별표(*)는 필수 항목</span></div>
      <div class="form-field">
        <label for="projectType">프로젝트 유형 <span aria-hidden="true">*</span></label>
        <div class="project-type-chips" role="group" aria-label="프로젝트 유형 선택">
          {Object.entries(projectTypes).map(([value, label]) => (
            <button type="button" class="chip-btn" data-value={value} aria-pressed="false">{label}</button>
          ))}
        </div>
        <select id="projectType" name="projectType" required aria-describedby="error-projectType" class="project-type-select-hidden"><option value="">어떤 프로젝트를 생각하고 계신가요?</option>{Object.entries(projectTypes).map(([value, label]) => <option value={value}>{label}</option>)}</select>
        <p class="field-error" id="error-projectType"></p>
      </div>
      <div class="form-row">{choiceFields.map(({ name, label, choices }) => <div class="form-field">
        <label for={name}>{label} <span aria-hidden="true">*</span></label>
        <select id={name} name={name} required aria-describedby={`error-${name}`}><option value="">선택해 주세요</option>{Object.entries(choices).map(([value, text]) => <option value={value}>{text}</option>)}</select>
        <p class="field-error" id={`error-${name}`}></p>
      </div>)}</div>
      <div class="form-field">
        <label for="description">프로젝트 내용 <span aria-hidden="true">*</span></label>
        <textarea id="description" name="description" rows="7" minlength="20" maxlength="5000" required aria-describedby="description-help error-description" placeholder="어떤 것을 만들고 싶으신가요?&#10;해결하고 싶은 문제, 현재 준비된 것, 참고 링크를 알려주세요."></textarea>
        <div class="field-caption"><span id="description-help">20자 이상 · 파일은 접수 후 별도 전달해 주세요.</span><span id="description-count">0 / 5,000</span></div>
        <p class="field-error" id="error-description"></p>
      </div>
      <div class="form-section-label"><span>02 / ABOUT YOU</span><span>이메일로 답변드립니다</span></div>
      <div class="form-row">
        <div class="form-field"><label for="name">이름 <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" minlength="2" maxlength="50" required aria-describedby="error-name" placeholder="성함을 알려주세요" /><p class="field-error" id="error-name"></p></div>
        <div class="form-field"><label for="email">이메일 <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="error-email" placeholder="you@company.com" /><p class="field-error" id="error-email"></p></div>
      </div>
      <div class="form-row">
        <div class="form-field"><label for="company">회사 · 팀 <span class="text-muted">(선택)</span></label><input id="company" name="company" autocomplete="organization" maxlength="100" aria-describedby="error-company" placeholder="함께하는 회사나 팀" /><p class="field-error" id="error-company"></p></div>
        <div class="form-field"><label for="phone">연락처 <span class="text-muted">(선택)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="30" aria-describedby="error-phone" placeholder="010-0000-0000" /><p class="field-error" id="error-phone"></p></div>
      </div>
      <div class="form-section-label"><span>03 / PRIVACY</span><a href="/privacy" target="_blank" rel="noopener">개인정보처리방침 ↗ <span class="sr-only">새 창</span></a></div>
      <div class="consent-summary">
        <p>목적: 프로젝트 문의 접수·검토 및 답변</p>
        <p>필수 항목: 이름, 이메일, 프로젝트 유형·예산·일정·내용, 동의 기록</p>
        <p>보관 기간: 처리 종료 후 1년 / 미종결 문의는 접수 후 최대 2년</p>
        <p>필수 동의를 거부할 수 있으나 온라인 접수는 제한됩니다. 선택정보는 제공하지 않아도 문의할 수 있습니다.</p>
      </div>
      <label class="consent-label" for="consent"><input id="consent" name="consent" type="checkbox" required aria-describedby="error-consent" /><span>[필수] 위 개인정보 수집·이용에 동의합니다.</span></label>
      <p class="field-error" id="error-consent"></p>
      <label class="consent-label" for="optionalConsent"><input id="optionalConsent" name="optionalConsent" type="checkbox" aria-describedby="optional-help error-optionalConsent" /><span>[선택] 회사·팀 및 연락처의 수집·이용에 동의합니다.</span></label>
      <p class="field-caption" id="optional-help">선택정보의 목적과 보관 기간은 위와 같습니다. 입력하지 않았다면 동의하지 않아도 됩니다.</p>
      <p class="field-error" id="error-optionalConsent"></p>
      <p class="field-error" id="error-policyVersion"></p>
      <input type="hidden" name="policyVersion" value={POLICY_VERSION} />
      <div class="form-trap" aria-hidden="true"><label for="website">웹사이트 주소는 이 칸에 입력하지 마세요.</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
    </fieldset>
    <div id="contact-challenge" aria-label="자동 접수 방지 보안 확인"></div>
    <p class="form-status" id="form-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
    <button class="button button-primary inquiry-submit" type="submit" disabled>프로젝트 문의 보내기 <span aria-hidden="true">↗</span></button>
    <p class="field-caption form-footnote">민감한 개인정보나 계정 비밀번호는 적지 말아주세요.<br />입력 내용은 브라우저에 별도로 저장하지 않습니다.</p>
  </form>
  <div class="inquiry-success" id="inquiry-success" hidden tabindex="-1">
    <span class="success-mark" aria-hidden="true">✓</span>
    <p class="eyebrow">RECEIVED</p>
    <h3 class="ko-heading">프로젝트 문의가<br />접수되었습니다.</h3>
    <p class="body-copy">보내주신 내용을 확인한 뒤 입력하신 이메일로 연락드리겠습니다.</p>
    <p class="receipt-label">접수번호 <strong id="inquiry-receipt"></strong></p>
    <p class="field-caption">이 화면의 접수번호를 보관해 주세요. 접수 확인 메일은 별도로 발송하지 않습니다.</p>
  </div>
</div>
<script src="../scripts/contact.ts"></script>
