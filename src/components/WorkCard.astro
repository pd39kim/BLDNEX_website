---
import type { Work } from '../data/works';
import { Image } from 'astro:assets';
import shuffoCover from '../../public/assets/shuffo/01-main-puzzle.jpg';
const { work } = Astro.props as { work: Work };
---
<article class={`work-card work-card-${work.slug}`}>
  <a class="work-card-link" href={`/works/${work.slug}`} aria-label={`${work.title} — ${work.summary} 살펴보기`}>
    {work.slug === 'bldnex-website' ? (
      <div class="work-visual website-visual" aria-hidden="true">
        <span class="visual-label">YOU ARE LOOKING AT IT</span>
        <span class="product-cover-title">bldnex<span class="cover-dot">.com</span></span>
        <div class="cover-flow"><span>Build</span><i>→</i><span>Measure</span><i>→</i><span>Ship</span></div>
        <span class="visual-footnote">정적 생성 · 외부 요청 0건</span>
      </div>
    ) : work.slug === 'shuffo' ? (
      <div class="work-visual shuffo-visual">
        <span class="visual-label">PHOTO / PLAY / REPEAT</span>
        <Image src={shuffoCover} width={320} widths={[180, 320]} sizes="(max-width: 600px) 105px, 150px" format="webp" alt="Shuffo의 사진 퍼즐 시작 화면" loading="lazy" decoding="async" />
        <span class="visual-footnote">iPhone · App Store 출시</span>
      </div>
    ) : (
      <div class="work-visual previewlog-visual" aria-hidden="true">
        <span class="visual-label">FROM FOOTAGE TO EDITING</span>
        <span class="product-cover-title">PreviewLog<span class="cover-dot">.</span></span>
        <div class="cover-flow"><span>Draft</span><i>→</i><span>Review</span><i>→</i><span>Deliver</span></div>
        <span class="visual-footnote">촬영본에서 편집용 자료까지</span>
      </div>
    )}
    <div class="work-card-body">
      <p class="eyebrow">{work.category}</p>
      <div class="work-title-row"><h3>{work.title}</h3><span class="card-arrow" aria-hidden="true">↗</span></div>
      <p class="work-summary">{work.summary}</p>
      <p class="body-copy">{work.description}</p>
      <ul class="tag-list">{work.tags.map((tag) => <li>{tag}</li>)}</ul>
      <span class="text-link">{work.title} 살펴보기 <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
