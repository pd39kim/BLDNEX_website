---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navigation } from '../data/site';

// Cloudflare Pages는 정적 자산에 매칭되지 않는 요청에 dist/404.html을 404 상태로 돌려줍니다.
// 이 파일이 없으면 모든 없는 주소가 홈 HTML을 200으로 반환해(소프트 404)
// 검색엔진이 중복 페이지로 수집합니다.
const works = [
  { href: '/works/previewlog', label: 'PreviewLog' },
  { href: '/works/shuffo', label: 'Shuffo' },
  { href: '/works/bldnex-website', label: 'bldnex.com' },
];
---
<BaseLayout
  title="페이지를 찾을 수 없습니다 · BLDNEX"
  description="요청하신 주소에 해당하는 페이지가 없습니다. BLDNEX의 서비스와 제품 페이지로 이동해 보세요."
  noindex
>
  <section class="page-hero section-wrap">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>Page not<span class="text-muted">found.</span></h1>
    <div class="page-intro">
      <h2 class="ko-heading">주소가 바뀌었거나,<br />없는 페이지입니다.</h2>
      <p class="body-copy">입력하신 주소를 다시 확인해 주세요. 아래에서 필요한 페이지로 바로 이동하실 수 있습니다. 찾으시는 내용이 있다면 문의를 남겨주시면 안내해 드리겠습니다.</p>
    </div>
  </section>

  <section class="content-section section-wrap">
    <div class="notfound-links">
      <nav aria-label="주요 메뉴">
        <p class="eyebrow">EXPLORE</p>
        {navigation.map((item) => <a class="text-link" href={item.href}>{item.label}</a>)}
      </nav>
      <nav aria-label="제품 메뉴">
        <p class="eyebrow">OUR WORK</p>
        {works.map((work) => <a class="text-link" href={work.href}>{work.label}</a>)}
      </nav>
      <div>
        <p class="eyebrow">START HERE</p>
        <a class="button button-primary" href="/">홈으로 돌아가기</a>
      </div>
    </div>
  </section>
</BaseLayout>
