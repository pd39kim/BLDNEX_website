---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CallToAction from '../components/CallToAction.astro';
import { collaborationStandards } from '../data/process';
import { pageMeta } from '../data/site';
const principles = [
  { name: 'MOVE FAST', title: '먼저 확인할 것을 정합니다.', description: '모든 기능을 한 번에 넣기보다 제품의 목적을 확인할 핵심 흐름부터 구체화합니다.' },
  { name: 'MAKE IT SOLID', title: '보이는 곳과 작동하는 곳을 함께 봅니다.', description: '화면의 가독성, 입력과 오류 처리, 데이터 흐름처럼 실제 사용에 필요한 부분을 챙깁니다.' },
  { name: 'FROM IDEA TO LAUNCH', title: '다음 사람이 이어갈 수 있게 정리합니다.', description: '출시 준비와 기본 운영에 필요한 내용을 정리하고, 추가 개선 범위를 구분합니다.' },
];
---
<BaseLayout {...pageMeta.about}>
  <PageHero eyebrow="ABOUT BLDNEX" lines={['We build our own.', 'Then we build yours.']} heading="직접 만들고 운영해 본 경험으로 만듭니다." description="BLDNEX는 웹사이트, SaaS, 모바일 앱과 디지털 제품을 만드는 제품 개발 스튜디오입니다. PreviewLog와 Shuffo를 직접 기획하고 개발해 운영하면서, 화면 하나와 기능 하나가 실제 사용과 운영에 어떤 영향을 주는지 확인해 왔습니다. 그 기준을 고객의 제품에 그대로 적용합니다." />
  <section class="content-section section-wrap editorial-section">
    <p class="eyebrow">BUILD WHAT’S NEXT</p>
    <div class="editorial-copy"><h2 class="ko-heading">다음은,<br />지금 필요한 것에서 시작합니다.</h2><p class="body-copy">브랜드를 처음 소개하는 웹사이트일 수도, 반복되는 업무를 줄이는 도구일 수도 있습니다.</p><p class="body-copy">BLDNEX가 생각하는 다음 제품은 새로운 기술을 나열하는 데서 시작하지 않습니다. 누가 어떤 상황에서 사용할지 이해하고, 가장 필요한 경험부터 만드는 데서 시작합니다.</p></div>
  </section>
  <section class="content-section section-wrap editorial-section">
    <p class="eyebrow">OUR OWN PRODUCTS</p>
    <div class="editorial-copy"><h2 class="ko-heading">제품을 직접 만들고 운영하며<br /><span class="text-muted">더 구체적인 기준을 쌓습니다.</span></h2><p class="body-copy">PreviewLog에서는 촬영본을 검토하고 전달하는 흐름을, Shuffo에서는 사진을 고르고 퍼즐을 즐기는 흐름을 다룹니다.</p><p class="body-copy">서로 다른 제품을 만들고 운영하며 화면의 표현, 기능의 동작, 출시한 뒤에 드러나는 문제까지 직접 겪습니다. 그래서 의뢰받은 제품에서도 지금 필요한 것과 나중에 해도 되는 것을 구분해 제안할 수 있습니다.</p><div class="actions"><a class="text-link" href="/works/previewlog">PreviewLog 보기 ↗</a><a class="text-link" href="/works/shuffo">Shuffo 보기 ↗</a></div></div>
  </section>
  <section class="content-section section-wrap" id="working-together">
    <SectionHeading eyebrow="WORKING TOGETHER" lines={['같은 목표를 보고,', '투명한 기준으로 협업합니다.']} description="자체 제품을 만들고 운영하며 검증한 방식을 고객의 프로젝트에도 그대로 적용합니다. 시작부터 배포까지 신뢰를 만드는 4가지 협업 기준입니다." />
    <ol class="collaboration-grid">
      {collaborationStandards.map((item) => (
        <li>
          <span class="step-number">{item.step}</span>
          <h3>{item.name}</h3>
          <p class="step-title">{item.title}</p>
          <p class="body-copy">{item.description}</p>
          <p class="collab-rule"><span>협업 기준</span>{item.rule}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="content-section section-wrap">
    <SectionHeading eyebrow="OUR PRINCIPLES" lines={['만드는 과정에서도', '기준은 분명하게.']} />
    <div class="capability-grid">{principles.map((principle) => <article><p class="eyebrow">{principle.name}</p><h3 class="ko-heading">{principle.title}</h3><p class="body-copy">{principle.description}</p></article>)}</div>
  </section>
  <CallToAction title="BLDNEX가 일하는 방식에 공감하시나요?" description="만들고 싶은 제품이 있다면 편하게 이야기를 들려주세요. 시작할 지점부터 함께 찾겠습니다." label="프로젝트 문의" />
</BaseLayout>
