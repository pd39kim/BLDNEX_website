---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Process from '../components/Process.astro';
import FAQ from '../components/FAQ.astro';
import CallToAction from '../components/CallToAction.astro';
import { works } from '../data/works';
import { services } from '../data/services';
import appStore from '../data/app-store.json';
const featuredWorks = works.filter((work) => work.slug !== 'bldnex-website');
---
<BaseLayout>
  <section class="hero section-wrap">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>PRODUCT DEVELOPMENT STUDIO</p>
    <h1>BUILD<br /><em>WHAT'S NEXT.</em></h1>
    <div class="hero-bottom">
      <div class="hero-copy"><h2 class="ko-heading">아이디어를, 실제로 쓰이는 제품으로.</h2><p class="body-copy">BLDNEX는 스타트업과 기업, 개인창업자의 웹사이트·SaaS·모바일 앱을 만듭니다. 무엇을 만들지 정리하는 일부터 디자인, 개발, 출시 준비까지 함께합니다.</p></div>
      <div class="hero-actions"><a class="button button-primary" href="/contact">프로젝트 문의 <span aria-hidden="true">↗</span></a><a class="text-link" href="#works">만든 제품 보기 <span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="hero-footnote"><span>웹사이트 · 웹앱/SaaS · 모바일 앱</span><span aria-hidden="true">IDEA → PRODUCT</span></div>
    {/* 수치는 scripts/measure-site.mjs가 빌드된 dist를 실측해 채웁니다. */}
    <aside class="build-stamp" aria-label="이 페이지의 실측 수치">
      <span class="build-stamp-label">THIS PAGE</span>
      <dl>
        <div><dt>용량</dt><dd>__PAGE_WEIGHT__</dd></div>
        <div><dt>JavaScript</dt><dd>__JS_WEIGHT__</dd></div>
        <div><dt>외부 요청</dt><dd>__THIRD_PARTY__건</dd></div>
        <div><dt>빌드</dt><dd><time datetime="__BUILD_DATE__">__BUILD_DATE__</time></dd></div>
      </dl>
      <a class="text-link" href="/works/bldnex-website">측정 방법 보기</a>
    </aside>
  </section>

  <section class="content-section section-wrap" id="works">
    <SectionHeading eyebrow="SELECTED WORKS" lines={['직접 만드는 제품,', '구체적인 경험.']} description="촬영본을 정리하는 데스크톱 도구부터 사진으로 즐기는 모바일 퍼즐까지. 서로 다른 사용 장면을 제품으로 풀어가는 방식을 소개합니다."><a class="text-link" href="/works">전체 제품 목록 보기 <span aria-hidden="true">↗</span></a></SectionHeading>
    <div class="works-grid">{featuredWorks.map((work) => <WorkCard work={work} />)}</div>
    {/* 앱 정보는 src/data/app-store.json. pnpm assets:appstore로 App Store에서 받아 갱신합니다. */}
    <aside class="store-callout">
      <img class="store-icon" src="/assets/shuffo/app-icon.webp" alt="Shuffo 앱 아이콘" width="192" height="192" loading="lazy" decoding="async" />
      <div class="store-copy">
        <p class="eyebrow">SHIPPED ON THE APP STORE</p>
        <h3 class="ko-heading">기획부터 스토어 심사 통과까지, 실제 제품으로 완성했습니다.</h3>
        <p class="body-copy">{appStore.genre === 'Games' ? '게임' : appStore.genre} · iOS {appStore.minimumOs} 이상 · {appStore.releaseDate.slice(0, 4)}년 {Number(appStore.releaseDate.slice(5, 7))}월 출시 · 최신 버전 {appStore.version}</p>
      </div>
      <a class="store-badge" href={appStore.url} target="_blank" rel="noopener noreferrer">
        <img src="/assets/shuffo/app-store-badge-ko.svg" alt={`App Store에서 ${appStore.name} 다운로드`} width="130" height="40" loading="lazy" decoding="async" />
        <span class="sr-only">(새 창)</span>
      </a>
    </aside>
  </section>

  <section class="content-section section-wrap" id="services">
    <SectionHeading eyebrow="WHAT WE BUILD" lines={['지금 필요한 제품부터,', '다음 단계까지.']} description="브랜드를 소개할 웹사이트, 업무를 바꿀 웹앱, 사용자에게 닿을 모바일 앱. 프로젝트의 목적과 사용 환경에 맞춰 필요한 범위를 함께 정리합니다." />
    <div class="service-grid">
      {services.map((service) => <a class="service-card" href={`/services#${service.id}`}><span class="step-number">{service.number}</span><h3>{service.name}</h3><p class="service-card-title">{service.shortTitle}</p><p class="body-copy">{service.summary}</p><span class="text-link">{service.linkLabel} <span aria-hidden="true">↗</span></span></a>)}
    </div>
    <div class="section-tail"><p>UI/UX 디자인 · 백엔드/API · 데스크톱 앱·게임도 프로젝트에 맞춰 함께 구성합니다.</p><a class="text-link" href="/services">전체 서비스 보기 ↗</a></div>
  </section>

  <section class="content-section section-wrap" id="process">
    <SectionHeading eyebrow="HOW WE WORK" lines={['막연한 아이디어를', '확인 가능한 단계로.']} description="무엇을 만들고, 무엇을 먼저 확인할지 함께 정합니다. 각 단계의 결과를 바탕으로 다음 작업의 범위를 구체화합니다." />
    <Process />
    <div class="section-tail"><p>필요한 것부터 만들고, 작동하는 결과로 확인합니다.</p><a class="text-link" href="/about#working-together">일하는 방식 자세히 보기 ↗</a></div>
  </section>

  <section class="content-section section-wrap studio-section">
    <div><p class="eyebrow">WE RUN WHAT WE BUILD.</p><h2 class="ko-heading">직접 만들고 운영하며<br /><span class="text-muted">축적한 실전 기준.</span></h2></div>
    <div class="studio-copy"><p class="body-copy">자체 제품을 기획·출시·운영해 본 경험을 바탕으로, 의뢰받은 프로젝트에서도 지금 먼저 확인할 것과 나중에 해도 되는 것을 명확히 구분해 제안합니다.</p><a class="text-link" href="/about">일하는 방식과 원칙 보기 ↗</a></div>
  </section>

  <section class="content-section section-wrap faq-section">
    <div><SectionHeading eyebrow="BEFORE WE START" lines={['시작하기 전에', '궁금할 수 있는 것들.']} /><a class="text-link" href="/contact#faq">문의 안내 더 보기 ↗</a></div>
    <FAQ limit={3} />
  </section>
  <CallToAction title="다음 제품의 시작을 함께 정리해 보세요." description="만들고 싶은 것과 지금 고민하는 점을 알려주세요. 구체적인 기능 목록이 없어도 괜찮습니다." label="프로젝트 문의" />
</BaseLayout>
