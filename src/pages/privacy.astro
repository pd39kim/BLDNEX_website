---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { privacySections, privacyPending } from '../data/privacy';
---
<BaseLayout title="개인정보처리방침 · BLDNEX" description="BLDNEX가 수집하는 개인정보의 항목과 이용 목적, 보유 기간, 정보주체의 권리 행사 방법을 안내합니다." noindex>
  <section class="page-hero section-wrap">
    <p class="eyebrow">PRIVACY POLICY</p>
    <h1>Privacy<span class="text-muted">policy.</span></h1>
    <div class="privacy-intro">
      <p class="body-copy">{site.legalName}({site.name})는 개인정보 보호법 제30조에 따라 정보주체의 개인정보를 보호하고 관련 고충을 신속히 처리하기 위해 다음과 같이 개인정보처리방침을 수립·공개합니다.</p>
      {privacyPending && (
        <aside class="privacy-draft" role="note">
          <p class="eyebrow">DRAFT / 검토 중</p>
          <p class="body-copy">문의 폼 도입에 따른 개정 초안입니다. 보호책임자·주소 및 문의 보관 기준은 확정했으며, 외부 서비스의 실제 처리 범위·국외 이전·개정 시행일은 별도 검토가 필요합니다. 온라인 접수가 활성화되어 운영 중이며, 외부 공급자 세부 사항 검토를 병행하고 있습니다.</p>
        </aside>
      )}
    </div>
  </section>

  <section class="content-section section-wrap">
    <nav class="privacy-toc" aria-label="방침 목차">
      {privacySections.map((section) => <a href={`#${section.id}`}>{section.number} / {section.title} <span aria-hidden="true">↓</span></a>)}
    </nav>

    <div class="privacy-body">
      {privacySections.map((section) => (
        <article class="privacy-section" id={section.id}>
          <p class="eyebrow">{section.number}</p>
          <div class="privacy-section-body">
            <h2 class="ko-heading">{section.title}</h2>
            {section.blocks.map((block) => {
              if (block.type === 'text') return <p class="body-copy">{block.value}</p>;
              if (block.type === 'list') return <ul class="privacy-list">{block.items.map((item) => <li class="body-copy">{item}</li>)}</ul>;
              return (
                <div class="privacy-table-wrap">
                  <table class="privacy-table">
                    <thead><tr>{block.head.map((cell) => <th scope="col">{cell}</th>)}</tr></thead>
                    <tbody>{block.rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
                  </table>
                </div>
              );
            })}
          </div>
        </article>
      ))}
    </div>

    <div class="section-tail">
      <p>개인정보 관련 문의는 아래 이메일로 보내 주세요.</p>
      <a class="text-link email-link" href={`mailto:${site.email}?subject=${encodeURIComponent('[개인정보 문의]')}`}>{site.email}</a>
    </div>
  </section>
</BaseLayout>
