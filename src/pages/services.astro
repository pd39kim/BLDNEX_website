---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CallToAction from '../components/CallToAction.astro';
import { services, capabilities } from '../data/services';
import { pageMeta } from '../data/site';
---
<BaseLayout {...pageMeta.services}>
  <PageHero eyebrow="SERVICES" lines={['Built around', 'what you need.']} heading="목적에 맞는 범위로, 완성도 높은 제품을 만듭니다." description="브랜드 웹사이트부터 업무용 웹앱, SaaS, 모바일 앱까지. 목표와 사용자, 운영 환경을 기준으로 프로젝트에 필요한 범위를 정합니다.">
    <nav class="anchor-nav" aria-label="서비스 바로가기">{services.map((service) => <a href={`#${service.id}`}>{service.number} / {service.name} <span aria-hidden="true">↓</span></a>)}</nav>
  </PageHero>
  {services.map((service) => (
    <section class="content-section section-wrap service-detail" id={service.id}>
      <div class="service-detail-intro"><p class="eyebrow">{service.number} / {service.name.toUpperCase()}</p><h2 class="ko-heading">{service.heading.map((line) => <span>{line}</span>)}</h2><p class="body-copy">{service.description}</p><a class="button" href="/contact">{service.cta} <span aria-hidden="true">↗</span></a></div>
      <div class="service-detail-body">
        <div><h3 class="ko-heading">이런 상황에 적합합니다</h3><ul class="plain-list">{service.situations.map((situation) => <li>{situation}</li>)}</ul></div>
        <div><h3 class="ko-heading">함께 만드는 범위</h3><ul class="tag-list">{service.scope.map((scope) => <li>{scope}</li>)}</ul></div>
        <div class="service-detail-pair"><div><h3 class="ko-heading">산출물 예시</h3><p class="body-copy">{service.outputs}</p></div><div><h3 class="ko-heading">시작할 때 알려주세요</h3><p class="body-copy">{service.prepare}</p></div></div>
        {service.id === 'mobile-apps' && <a class="related-product" href="/works/shuffo"><span><span class="eyebrow">RELATED PRODUCT</span>Shuffo — 사진 기반 모바일 퍼즐</span><span aria-hidden="true">↗</span></a>}
      </div>
    </section>
  ))}
  <section class="content-section section-wrap">
    <SectionHeading eyebrow="CONNECTED CAPABILITIES" lines={['제품에 필요한 부분을', '함께 연결합니다.']} />
    <div class="capability-grid">{capabilities.map((capability) => <article><h3>{capability.title}</h3><p class="body-copy">{capability.description}</p></article>)}</div>
    <div class="scope-note"><p>프로젝트에 필요한 범위를 함께 정합니다.</p><p class="body-copy">기능, 플랫폼, 연동, 운영 지원과 산출물은 협의한 범위에 따라 구성합니다.</p></div>
    <div class="section-tail"><p>문제 정리 → 화면과 흐름 설계 → 구현과 검수 → 출시 준비</p><a class="text-link" href="/about#working-together">진행 방식 보기 ↗</a></div>
  </section>
  <CallToAction title="어떤 서비스가 맞는지 고민되시나요?" description="해결하려는 문제와 현재 준비 상태를 알려주시면, 알맞은 개발 범위와 협업 방식을 함께 정리해 드립니다." label="서비스 범위 문의" />
</BaseLayout>
