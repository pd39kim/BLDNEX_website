---
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import photoSelect from '../../../public/assets/shuffo/04-photo-select-travel.jpg';
import mainPuzzle from '../../../public/assets/shuffo/01-main-puzzle.jpg';
import travelGame from '../../../public/assets/shuffo/03-game-travel.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CallToAction from '../../components/CallToAction.astro';
import { works } from '../../data/works';
import { site, pageMeta } from '../../data/site';
// bldnex-website는 제품 상세와 구성이 달라 전용 페이지(bldnex-website.astro)로 둡니다.
export function getStaticPaths() {
  return works
    .filter((work) => work.slug !== 'bldnex-website')
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { work } = Astro.props;
const isPreviewLog = work.slug === 'previewlog';
const previewSteps = [
  { name: 'DRAFT YOUR PREVIEW', title: '먼저, 검토할 초안을 만듭니다.', description: '프록시 촬영본에서 대표 컷, 한국어 전사와 타임코드, 장면 정보를 정리합니다.' },
  { name: 'REVIEW & REFINE', title: '필요한 컷과 내용을 직접 고릅니다.', description: '컷과 대사를 확인하고 로그를 수정합니다. 무음·흐림·노출 등 검토 항목을 살펴 전달할 내용을 정합니다.' },
  { name: 'DELIVER TO EDITING', title: '검토한 내용을 결과물로 전달합니다.', description: '선택한 컷과 수정한 로그를 편집·검토 목적에 맞는 파일로 내보냅니다.' },
];
const shuffoSteps = [
  { title: '사진을 고릅니다.', description: '보관함의 사진이나 여행·동물·명화 이미지로 시작합니다.' },
  { title: '조각을 맞춥니다.', description: '3×3부터 6×6까지 난이도를 고르고, 터치나 드래그로 조각을 이동합니다.' },
  { title: '함께 도전합니다.', description: '퍼즐 링크를 보내 친구와 같은 사진을 즐길 수 있습니다.' },
];
const screenshots = [
  { image: photoSelect, caption: '사진을 선택하는 단계', alt: 'Shuffo의 여행 이미지 선택 화면' },
  { image: mainPuzzle, caption: '선택한 사진으로 시작하는 퍼즐', alt: 'Shuffo의 사진 퍼즐 시작 화면' },
  { image: travelGame, caption: '조각을 움직이며 맞추는 화면', alt: 'Shuffo의 여행 사진 퍼즐 화면' },
];

const breadcrumb = [
  { name: 'BLDNEX', path: '/' },
  { name: 'Works', path: '/works' },
  { name: work.title, path: `/works/${work.slug}` },
];

/**
 * 확인된 사실만 기재합니다. Shuffo는 공개된 App Store 페이지가 있으므로 installUrl을 포함하고,
 * PreviewLog는 공개 배포 상태가 확인되지 않아 외부 주소나 가격·평점을 넣지 않습니다.
 */
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: work.title,
  description: pageMeta[work.slug].description,
  url: new URL(`/works/${work.slug}`, site.siteUrl).href,
  inLanguage: 'ko-KR',
  author: { '@type': 'Organization', name: site.name, url: site.siteUrl },
  publisher: { '@type': 'Organization', name: site.name, url: site.siteUrl },
  ...(isPreviewLog
    ? { applicationCategory: 'MultimediaApplication' }
    : { applicationCategory: 'GameApplication', operatingSystem: 'iOS', installUrl: site.shuffoUrl, sameAs: site.shuffoUrl }),
};
---
<BaseLayout {...pageMeta[work.slug]} ogType="article" breadcrumb={breadcrumb} schema={productSchema}>
  <section class="page-hero product-hero section-wrap">
    <a class="text-link back-link" href="/works">← 다른 제품 보기</a>
    <p class="eyebrow">{work.category} / BLDNEX OWN PRODUCT</p>
    <h1>{work.title}<span class="cover-dot">.</span></h1>
    <div class="page-intro">
      <h2 class="ko-heading">{isPreviewLog ? <>촬영본을 정리해,<br />편집을 준비하는 다음 단계로.</> : <>좋아하는 사진이<br />작은 퍼즐이 됩니다.</>}</h2>
      <p class="body-copy">{isPreviewLog ? 'PreviewLog는 프록시 촬영본을 분석해 대표 컷, 대사, 타임코드와 검토 정보를 정리하는 데스크톱 앱입니다. 사용자가 초안을 확인하고 수정한 뒤, 편집에 필요한 자료로 내보내는 흐름을 제공합니다.' : 'Shuffo는 사진을 골라 조각을 맞추는 iPhone용 슬라이드 퍼즐입니다. BLDNEX가 직접 개발해 App Store에 공개한 자체 게임입니다.'}</p>
    </div>
    <div class="product-meta">
      <div><span>PRODUCT TYPE</span><p>{isPreviewLog ? '로컬 우선 데스크톱 앱' : 'iPhone · 슬라이드 퍼즐'}</p></div>
      <div><span>{isPreviewLog ? 'DESIGNED FOR' : 'AVAILABLE ON'}</span><p>{isPreviewLog ? '조연출 · 프리뷰 작가 · 영상 제작팀' : 'App Store'}</p></div>
      {!isPreviewLog && <a class="button button-primary" href={site.shuffoUrl} target="_blank" rel="noopener noreferrer">App Store에서 보기 <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></a>}
    </div>
  </section>
  {isPreviewLog ? (
    <>
      <section class="content-section section-wrap editorial-section">
        <p class="eyebrow">THE CONTEXT</p>
        <div class="editorial-copy"><h2 class="ko-heading">촬영 다음에는,<br /><span class="text-muted">다시 보고 정리하는 일이 남습니다.</span></h2><p class="body-copy">촬영본을 편집자에게 전달하려면 어떤 장면인지, 어떤 대사가 있는지, 다시 확인할 지점은 어디인지 함께 정리해야 합니다.</p><p class="body-copy">PreviewLog는 이 정보를 검토 가능한 초안으로 모으고, 사람이 확인한 내용을 다음 작업에 전달하는 흐름을 다룹니다.</p></div>
      </section>
      <section class="content-section section-wrap">
        <SectionHeading eyebrow="THE PRODUCT FLOW" lines={['초안에서 검토로,', '검토에서 편집용 자료로.']} />
        <ol class="product-flow">{previewSteps.map((step, index) => <li><div class="flow-top"><span class="step-number">0{index + 1}</span><span aria-hidden="true">→</span></div><p class="eyebrow">{step.name}</p><h3 class="ko-heading">{step.title}</h3><p class="body-copy">{step.description}</p></li>)}</ol>
        <p class="figure-note">제품 작업 흐름을 설명하는 도식입니다. 실제 앱 화면이 아닙니다.</p>
      </section>
      <section class="content-section section-wrap">
        <SectionHeading eyebrow="FROM REVIEW TO HANDOFF" lines={['다음 작업자가', '사용할 수 있는 형태로.']} description="HTML 프리뷰, PDF 콘택트시트, CSV와 자막 파일 등 검토 목적에 맞는 형식으로 자료를 정리합니다. 원본·프록시 파일은 읽기 전용으로 다루고, 분석 결과는 프로젝트 폴더에서 별도로 관리합니다." />
        <div class="capability-grid">
          <article><h3 class="ko-heading">사용자 검토</h3><p class="body-copy">자동 생성된 초안을 확인하고 수정할 수 있는 흐름</p></article>
          <article><h3 class="ko-heading">로컬 기본 분석</h3><p class="body-copy">촬영 자료를 사용자의 작업 환경에서 분석하는 구조</p></article>
          <article><h3 class="ko-heading">작업 전달</h3><p class="body-copy">검토한 내용을 다음 작업에 사용할 파일로 내보내는 과정</p></article>
        </div>
        <aside class="scope-note"><p>PreviewLog 제품 소개 안내</p><p class="body-copy">제품 소개 자료를 기준으로 정리한 내용입니다. 현재 이 페이지에서는 다운로드를 제공하지 않습니다. 최신 지원 환경과 배포 정보는 별도로 안내합니다.</p></aside>
      </section>
      <CallToAction title="이런 작업 도구가 필요하신가요?" description="반복되는 정리 작업과 실제 사용 흐름을 제품으로 만드는 방법을 함께 살펴보겠습니다." label="업무 도구 개발 문의" />
    </>
  ) : (
    <>
      <section class="screenshot-section section-wrap" aria-labelledby="screens-heading">
        <SectionHeading id="screens-heading" eyebrow="A CLOSER LOOK" lines={['사진을 고르는 순간부터,', '마지막 조각까지.']} />
        <div class="screenshot-grid">{screenshots.map((screenshot, index) => <figure><div class="screenshot-stage"><Image src={screenshot.image} width={540} widths={[300, 540, 810]} sizes="(max-width: 600px) 230px, (max-width: 900px) 28vw, 270px" format="webp" alt={screenshot.alt} loading="lazy" decoding="async" /></div><figcaption><span class="step-number">0{index + 1}</span>{screenshot.caption}</figcaption></figure>)}</div>
      </section>
      <section class="content-section section-wrap">
        <SectionHeading eyebrow="THE EXPERIENCE" lines={['익숙한 사진으로,', '새로운 한 판.']} />
        <div class="capability-grid">{shuffoSteps.map((step) => <article><h3 class="ko-heading">{step.title}</h3><p class="body-copy">{step.description}</p></article>)}</div>
      </section>
      <section class="content-section section-wrap store-section">
        <img src="/assets/shuffo/app-icon.jpg" width="512" height="512" alt="" loading="lazy" />
        <div><p class="eyebrow">AVAILABLE ON THE APP STORE</p><h2 class="ko-heading">실제로 플레이할 수 있는 결과물.</h2><p class="body-copy">Shuffo의 앱 정보는 App Store에서 확인할 수 있습니다.</p></div>
        <a class="button" href={site.shuffoUrl} target="_blank" rel="noopener noreferrer">App Store에서 보기 <span aria-hidden="true">↗</span><span class="sr-only">(새 창)</span></a>
      </section>
      <CallToAction title="모바일에서 만들고 싶은 경험이 있나요?" description="사용자가 처음 만나는 화면부터 핵심 기능까지 함께 정리해보세요." label="모바일 앱 개발 문의" />
    </>
  )}
</BaseLayout>
