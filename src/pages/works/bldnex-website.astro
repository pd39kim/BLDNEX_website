---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CallToAction from '../../components/CallToAction.astro';
import { site, pageMeta } from '../../data/site';

// __PAGE_WEIGHT__ 같은 토큰은 scripts/measure-site.mjs가 빌드된 dist를 실측해 채웁니다.
// 숫자를 손으로 적지 않으므로 내용이 바뀌면 다음 배포에서 자동으로 갱신됩니다.

const breadcrumb = [
  { name: 'BLDNEX', path: '/' },
  { name: 'Works', path: '/works' },
  { name: 'bldnex.com', path: '/works/bldnex-website' },
];

// BaseLayout이 사이트 전역 WebSite를 이미 내보내므로, 여기서는 작업물로서
// CreativeWork를 씁니다. 같은 페이지에 WebSite가 두 번 나오지 않게 합니다.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'bldnex.com',
  description: pageMeta['bldnex-website'].description,
  url: site.siteUrl,
  inLanguage: 'ko-KR',
  author: { '@type': 'Organization', name: site.name, url: site.siteUrl },
};

const stack = [
  { name: 'Astro 5', role: '정적 사이트 생성', detail: '모든 페이지를 빌드 시점에 HTML로 만들어 둡니다. 요청마다 서버가 렌더링하지 않습니다.' },
  { name: 'TypeScript', role: '콘텐츠 데이터 모델', detail: '서비스·제품·FAQ·방침 원고를 타입이 있는 데이터로 두고 페이지에서 재사용합니다.' },
  { name: 'Cloudflare Pages', role: '호스팅 · 문의 처리', detail: '정적 페이지를 엣지에서 전송하고, 문의 저장과 관리자 API는 Functions와 D1으로 분리합니다. 실제 접수는 운영 연결·검토 후 활성화합니다.' },
  { name: 'Sharp · subset-font', role: '빌드 단계 에셋 생성', detail: '공유 이미지와 서브셋 폰트를 빌드할 때 만듭니다. 손으로 만든 산출물을 커밋하지 않습니다.' },
];

const checks = [
  '페이지마다 제목이 겹치지 않는지, h1이 하나인지',
  '내부 링크와 앵커가 전부 실제 대상에 닿는지',
  '모든 이미지에 대체 텍스트와 크기 속성이 있는지',
  '공유 이미지가 페이지마다 다르고 실제로 1200×630인지',
  'canonical과 og:url이 일치하고 슬래시가 붙지 않는지',
  '폰트 서브셋에서 빠진 글자가 없는지',
  '선언된 글꼴 굵기에 해당하는 파일이 있는지',
  '외부 폰트 호스트를 다시 참조하지 않는지',
  '미완성 페이지가 색인되거나 사이트맵에 들어가지 않는지',
  '문의가 저장된 뒤에만 성공 처리하고 중복 저장을 막는지',
  '관리자 인증·접근 제한과 알림 재시도·보관 기간 만료 처리가 작동하는지',
];
---
<BaseLayout {...pageMeta['bldnex-website']} ogType="article" breadcrumb={breadcrumb} schema={schema}>
  <section class="page-hero product-hero section-wrap">
    <a class="text-link back-link" href="/works">← 다른 제품 보기</a>
    <p class="eyebrow">WEBSITE / BLDNEX OWN PRODUCT</p>
    <h1>bldnex.com<span class="cover-dot">.</span></h1>
    <div class="page-intro">
      <h2 class="ko-heading">만든 걸 보시려면,<br /><span class="text-muted">지금 보고 계신 게 그겁니다.</span></h2>
      <p class="body-copy">이 웹사이트는 BLDNEX가 직접 기획하고 만들어 운영합니다. 아래 수치는 설명이 아니라 지금 열려 있는 이 사이트를 빌드할 때 실제로 잰 값입니다. 브라우저 개발자 도구를 열어 그대로 확인하실 수 있습니다.</p>
    </div>
    <div class="metric-grid">
      <div><span class="eyebrow">첫 방문 용량</span><p class="metric-value">__PAGE_WEIGHT__</p><p class="body-copy">HTML·CSS는 gzip 기준. 홈이 쓰지 않는 글꼴 굵기까지 더해 실제보다 크게 잡은 값입니다</p></div>
      <div><span class="eyebrow">홈 JavaScript</span><p class="metric-value">__JS_WEIGHT__</p><p class="body-copy">홈의 인라인 스크립트 기준. 문의·관리자 기능은 해당 화면에서만 불러옵니다</p></div>
      <div><span class="eyebrow">홈 외부 요청</span><p class="metric-value">__THIRD_PARTY__건</p><p class="body-copy">홈 기준. 문의 보안 확인과 관리자 인증은 별도 서비스와 연결됩니다</p></div>
      <div><span class="eyebrow">공개 페이지</span><p class="metric-value">__ROUTES__개</p><p class="body-copy">빌드 시점에 생성된 공개 HTML. 비공개 관리자와 API는 제외합니다</p></div>
    </div>
  </section>

  <section class="content-section section-wrap editorial-section">
    <p class="eyebrow">WHY IT MATTERS</p>
    <div class="editorial-copy">
      <h2 class="ko-heading">웹사이트를 만드는 회사의<br /><span class="text-muted">웹사이트부터 그래야 합니다.</span></h2>
      <p class="body-copy">처음에는 이 사이트도 글꼴을 외부 CDN에서 통째로 받고 있었습니다. HTML은 11 KB인데 실제로는 1.59 MB를 내려받고 있었고, 그중 98%가 쓰지도 않는 한글 글자였습니다.</p>
      <p class="body-copy">실제로 쓰는 글자를 세어 보니 한글 402자를 포함해 500자 남짓이었습니다. 빌드할 때마다 쓰인 글자만 추려 글꼴을 다시 만들도록 바꿨고, 글꼴 용량이 __FONT_WEIGHT__로 줄면서 외부 글꼴 요청도 함께 사라졌습니다.</p>
      <p class="body-copy">고객 프로젝트에서 성능과 개인정보를 이야기하기 전에, 우리 사이트에서 먼저 지키는 편이 설득력 있다고 생각합니다.</p>
    </div>
  </section>

  <section class="content-section section-wrap">
    <SectionHeading eyebrow="THE STACK" lines={['필요한 것만,', '직접 고르고 조립해서.']} description="유행하는 기술을 나열하기보다, 이 사이트가 실제로 하는 일에 필요한 것만 씁니다." />
    <div class="capability-grid stack-grid">
      {stack.map((item) => (
        <article>
          <p class="eyebrow">{item.role}</p>
          <h3 class="ko-heading">{item.name}</h3>
          <p class="body-copy">{item.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section section-wrap">
    <SectionHeading eyebrow="AUTOMATED REVIEW" lines={['사람이 눈으로 보는 대신,', '빌드가 먼저 막습니다.']} description="pnpm test 한 번에 아래 항목을 전부 확인하고, 하나라도 어긋나면 빌드가 실패합니다. 조용히 깨진 채로 배포되는 경우를 없애는 것이 목적입니다." />
    <ul class="check-list">{checks.map((check) => <li class="body-copy">{check}</li>)}</ul>
    <div class="section-tail">
      <p>마지막 빌드: <time datetime="__BUILD_DATE__">__BUILD_DATE__</time> · 검사 통과 후 배포됨</p>
    </div>
  </section>

  <CallToAction title="이런 기준으로 만들어 드릴까요?" description="지금 쓰고 계신 사이트의 용량과 외부 요청부터 함께 확인해 보겠습니다." label="웹사이트 제작 문의" />
</BaseLayout>
